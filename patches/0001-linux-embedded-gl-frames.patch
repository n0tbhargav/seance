+    /// A finished frame for hosts that composite CPU pixels (Linux).
+    /// Premultiplied RGBA8, `stride` bytes per row. Release with
+    /// ghostty_surface_release_frame when done.
+    pub const Frame = extern struct {
+        width: u32,
+        height: u32,
+        stride: u32,
+        pixels: ?[*]const u8,
+        handle: ?*anyopaque,
+    };
+
+    /// Take the latest rendered frame, if any. Call after receiving
+    /// GHOSTTY_ACTION_RENDER. Returns false if no frame is available.
+    export fn ghostty_surface_take_frame(surface: *Surface, out: *Frame) bool {
+        const R = @TypeOf(surface.core_surface.renderer);
+        if (comptime R.ExportedFrame == void) return false;
+        const frame = surface.core_surface.renderer.takeFrame() orelse return false;
+        switch (frame) {
+            .memory => |m| {
+                const h = surface.app.core_app.alloc.create(R.ExportedFrame) catch {
+                    frame.deinit();
+                    return false;
+                };
+                h.* = frame;
+                out.* = .{
+                    .width = m.width,
+                    .height = m.height,
+                    .stride = m.width * 4,
+                    .pixels = m.pixels.ptr,
+                    .handle = h,
+                };
+                return true;
+            },
+            .dmabuf => {
+                frame.deinit();
+                return false;
+            },
+        }
+    }
+
+    /// Release a frame obtained from ghostty_surface_take_frame.
+    export fn ghostty_surface_release_frame(surface: *Surface, handle: ?*anyopaque) void {
+        const R = @TypeOf(surface.core_surface.renderer);
+        if (comptime R.ExportedFrame == void) return;
+        const h: *R.ExportedFrame = @ptrCast(@alignCast(handle orelse return));
+        h.deinit();
+        surface.app.core_app.alloc.destroy(h);
+    }
